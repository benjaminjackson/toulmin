#!/usr/bin/env bash
# Blind head-to-head judge for the toulmin eval. smevals cannot pair runs, so this script does it.
#
#   pairwise [--judge opus|gemini|fable] <runs-dir>                                  judge every pair not judged yet
#   pairwise [--judge opus|gemini|fable] --print-prompt <runs-dir> <task> <k> <order>  print the exact prompt for one pair and order, with no model call
#
# --judge picks the model that judges (default opus). Every judge gets the same prompt.
# Opus results go to <runs-dir>/pairwise/, Gemini (gemini-4-argon) results to <runs-dir>/pairwise-gemini/,
# Fable (claude-fable-5-2) results to <runs-dir>/pairwise-fable/, with the same file names.
# Fable is held out for the sealed test: do not run it on tune rounds.
#
# For each task, the scored runs of each arm (as `summary --runs` decides) are put in time order,
# and the k-th with-skill run is paired with the k-th without-skill run (k counts from 1).
# Each pair is judged twice: order 1 shows the with-skill document as A, order 2 shows it as B.
# One JSON file per pair and order goes to the judge's results directory. A file that exists is not judged again.
# Each file has the winner, the margin ("clear", "slight" or "none") and the judge. Files written before the margin
# and judge fields existed have neither.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=lib/base.sh
source "$SCRIPT_DIR/lib/base.sh"
# shellcheck source=lib/gemini.sh
source "$SCRIPT_DIR/lib/gemini.sh"
# shellcheck source=lib/user-knows.sh
source "$SCRIPT_DIR/lib/user-knows.sh"

OPUS_PARALLEL_CALLS=8
GEMINI_PARALLEL_CALLS=4
GEMINI_MODEL=gemini-4-argon
FABLE_MODEL=claude-fable-5-2
VERDICT_SCHEMA='{"type":"object","properties":{"reason":{"type":"string"},"winner":{"type":"string","enum":["A","B","tie"]},"margin":{"type":"string","enum":["clear","slight","none"]}},"required":["reason","winner","margin"]}'

# Print usage and exit with the given status.
usage() {
  echo "usage: pairwise [--judge opus|gemini|fable] <runs-dir>" >&2
  echo "       pairwise [--judge opus|gemini|fable] --print-prompt <runs-dir> <task> <k> <order>" >&2
  exit "$1"
}

# Print the results directory for one judge: <runs-dir>/pairwise for opus, <runs-dir>/pairwise-<judge> for the others.
# Why: the judges must never overwrite or skip each other's results, and summary reads only the opus directory.
results_dir() {
  local runs_dir=$1
  local judge=$2
  if [ "$judge" = opus ]; then
    echo "$runs_dir/pairwise"
  else
    echo "$runs_dir/pairwise-$judge"
  fi
}

# Print the model name that claude is called with for a Claude judge: opus or claude-fable-5-2.
# Why: opus and fable share one code path in ask_judge and judge_one; only the model name differs.
claude_judge_model() {
  local judge=$1
  if [ "$judge" = fable ]; then
    echo "$FABLE_MODEL"
  else
    echo opus
  fi
}

# Print the run directory of the k-th scored run of one task and arm, in time order, or nothing if there is none.
# Why: both the prompt and the result file need the same pairing, so it is worked out in one place.
nth_scored_run() {
  local runs_json=$1
  local task=$2
  local arm=$3
  local index=$4
  echo "$runs_json" | jq -rs --arg task "$task" --arg arm "$arm" --argjson index "$index" '
    map(select(.task == $task and .arm == $arm and .scored))
    | sort_by(.started)
    | .[$index - 1].run_dir // empty'
}

# Print the judge prompt for one pair and order.
# Arguments: the with-skill run directory, the without-skill run directory, the order (1 or 2).
# The prompt holds only the reader, the brief and the two documents: no arm names, paths or tool names.
build_prompt() {
  local with_skill_run=$1
  local without_skill_run=$2
  local order=$3
  local reader
  reader=$(/opt/homebrew/bin/yq -r '.task.reader' "$with_skill_run/run.yaml")
  local brief
  brief=$(/opt/homebrew/bin/yq -r '.task.prompt' "$with_skill_run/run.yaml")
  local document_a_file
  local document_b_file
  if [ "$order" = 1 ]; then
    document_a_file="$with_skill_run/grades/judge/document.txt"
    document_b_file="$without_skill_run/grades/judge/document.txt"
  else
    document_a_file="$without_skill_run/grades/judge/document.txt"
    document_b_file="$with_skill_run/grades/judge/document.txt"
  fi
  printf 'You are this reader: %s\n\n' "$reader"
  printf 'A writer was given the brief below. You, the reader, have not seen this brief. It is here only so that you know the facts the writer had.\n\n'
  printf '<brief>\n%s\n</brief>\n\n' "$brief"
  # A task may carry a `judge_note` that settles an ambiguous fact in its brief. It is read from the task file,
  # not from run.yaml, so that runs made before the note was written are judged with it too.
  local task_name
  task_name=$(/opt/homebrew/bin/yq -r '.task.name' "$with_skill_run/run.yaml")
  local brief_note
  brief_note=$(/opt/homebrew/bin/yq -r '.judge_note // ""' "$(dirname "${BASH_SOURCE[0]}")/tasks/$task_name.yaml")
  if [ -n "$brief_note" ]; then
    printf 'The person who wrote the brief adds this about its facts: %s\n\n' "$brief_note"
  fi
  # What the user knew but did not put in the request (see lib/user-knows.sh). A task with none adds nothing.
  local user_knows_text
  user_knows_text=$(user_knows_paragraph "$task_name")
  if [ -n "$user_knows_text" ]; then
    printf '%s\n\n' "$user_knows_text"
  fi
  printf 'Two documents were written from this brief.\n\n'
  printf '<document_a>\n%s\n</document_a>\n\n' "$(cat "$document_a_file")"
  printf '<document_b>\n%s\n</document_b>\n\n' "$(cat "$document_b_file")"
  printf 'As the reader described above, say which document is more likely to bring you to agree or act, while it stays honest to the facts in the brief. If neither is more likely, say tie. Also say how big the gap is: "clear" if you would notice the difference without being asked to compare, "slight" if it is a close call, "none" if it is a tie. Reply with only a JSON object with three fields: "reason" (one or two sentences), "winner" ("A", "B" or "tie") and "margin" ("clear", "slight" or "none").\n'
}

# Ask the chosen judge for a verdict on the prompt in a file, and print the verdict as compact JSON, or nothing.
# Arguments: the judge (opus, gemini or fable), the prompt file.
# Why one function: judge_one then checks and writes the verdict the same way for every judge.
ask_judge() {
  local judge=$1
  local prompt_file=$2
  if [ "$judge" = gemini ]; then
    local answer
    # A failed call prints its one-line reason on stderr, which is kept so the user sees why.
    answer=$(gemini_text "$GEMINI_MODEL" < "$prompt_file") || true
    # Gemini may wrap the JSON in a code fence or add words around it. First try the whole reply as JSON;
    # if that fails, take the text from the first "{" to the last "}" and try that.
    # -R reads raw text, -s reads it all as one string; "try ... catch" moves on when fromjson fails.
    printf '%s' "$answer" | jq -Rsc '
      try fromjson
      catch ((capture("(?s)(?<object>\\{.*\\})").object // "") | fromjson? // null)' 2>/dev/null || true
    return
  fi
  local claude_model
  claude_model=$(claude_judge_model "$judge")
  local response
  # The judge's stderr is dropped; a failed call is caught by the caller through the missing winner.
  response=$(claude_stripped --model "$claude_model" --tools "" --output-format json --json-schema "$VERDICT_SCHEMA" < "$prompt_file" 2>/dev/null) || true
  # The verdict arrives in .structured_output, or as JSON text in .result on some versions; try both.
  # fromjson? returns nothing instead of an error when .result is not JSON.
  echo "$response" | jq -c '.structured_output // (.result | if type == "string" then (fromjson? // null) else . end)' 2>/dev/null || true
}

# Judge one pair in one order and write its result file. Prints one status line.
# Arguments: judge (opus, gemini or fable), runs directory, task, pair index k, order.
judge_one() {
  local judge=$1
  local runs_dir=$2
  local task=$3
  local index=$4
  local order=$5
  local result_file
  result_file="$(results_dir "$runs_dir" "$judge")/$task-pair$index-order$order.json"
  # The judge field names the model: opus for opus (as in older files), the full model name for the others.
  local judge_name
  judge_name=$(claude_judge_model "$judge")
  if [ "$judge" = gemini ]; then
    judge_name=$GEMINI_MODEL
  fi
  local runs_json
  runs_json=$("$SCRIPT_DIR/summary" --runs "$runs_dir")
  local with_skill_run
  with_skill_run=$(nth_scored_run "$runs_json" "$task" with-skill "$index")
  local without_skill_run
  without_skill_run=$(nth_scored_run "$runs_json" "$task" without-skill "$index")
  local prompt_file
  prompt_file=$(mktemp)
  build_prompt "$with_skill_run" "$without_skill_run" "$order" > "$prompt_file"
  local verdict
  verdict=$(ask_judge "$judge" "$prompt_file")
  rm -f "$prompt_file"
  # A verdict counts only when both the winner and the margin are one of the allowed words.
  if ! echo "$verdict" | jq -e '(.winner == "A" or .winner == "B" or .winner == "tie") and (.margin == "clear" or .margin == "slight" or .margin == "none")' > /dev/null 2>&1; then
    echo "FAIL $task pair $index order $order: no valid verdict" >&2
    return 1
  fi
  local a_arm=with-skill
  if [ "$order" = 2 ]; then
    a_arm=without-skill
  fi
  # Write to a temporary file first and rename it, so an interrupted run never leaves a half-written result.
  echo "$verdict" | jq \
    --arg task "$task" \
    --argjson pair "$index" \
    --argjson order "$order" \
    --arg with_skill_run "$(basename "$with_skill_run")" \
    --arg without_skill_run "$(basename "$without_skill_run")" \
    --arg a_arm "$a_arm" \
    --arg judge "$judge_name" '
    {
      judge: $judge,
      task: $task,
      pair: $pair,
      order: $order,
      with_skill_run: $with_skill_run,
      without_skill_run: $without_skill_run,
      a_arm: $a_arm,
      winner: .winner,
      winner_arm: (
        if .winner == "tie" then "tie"
        elif .winner == "A" then $a_arm
        elif $a_arm == "with-skill" then "without-skill"
        else "with-skill"
        end
      ),
      margin: .margin,
      reason: .reason
    }' > "$result_file.tmp"
  mv "$result_file.tmp" "$result_file"
  echo "ok   $task pair $index order $order: $(jq -r '"\(.winner_arm) (\(.margin))"' "$result_file")"
}

# List every pair and order the given judge has not judged yet, one "task k order" line each.
# Arguments: runs directory, judge (opus, gemini or fable).
list_missing_judgements() {
  local runs_dir=$1
  local judge=$2
  local judge_results_dir
  judge_results_dir=$(results_dir "$runs_dir" "$judge")
  local runs_json
  runs_json=$("$SCRIPT_DIR/summary" --runs "$runs_dir")
  local task
  for task in $(echo "$runs_json" | jq -rs 'map(.task) | unique | .[]'); do
    local pair_count
    pair_count=$(echo "$runs_json" | jq -s --arg task "$task" '
      map(select(.task == $task and .scored))
      | [(map(select(.arm == "with-skill")) | length), (map(select(.arm == "without-skill")) | length)]
      | min')
    local index
    for ((index = 1; index <= pair_count; index++)); do
      local order
      for order in 1 2; do
        if [ ! -f "$judge_results_dir/$task-pair$index-order$order.json" ]; then
          echo "$task $index $order"
        fi
      done
    done
  done
}

# Parse arguments and either print one prompt, judge one pair, or judge every missing pair in parallel.
# --judge may come anywhere on the command line; it is taken out first and the rest is read as before.
main() {
  local judge=opus
  local remaining_arguments=()
  while [ $# -gt 0 ]; do
    if [ "$1" = --judge ]; then
      if [ $# -lt 2 ]; then
        usage 1
      fi
      judge=$2
      shift 2
    else
      remaining_arguments+=("$1")
      shift
    fi
  done
  if [ "$judge" != opus ] && [ "$judge" != gemini ] && [ "$judge" != fable ]; then
    echo "pairwise: --judge must be opus, gemini or fable, not $judge" >&2
    usage 1
  fi
  # "${array[@]+...}" expands to nothing when the array is empty; plain "${array[@]}" fails under set -u on older bash.
  set -- ${remaining_arguments[@]+"${remaining_arguments[@]}"}

  case "${1:-}" in
    -h|--help)
      usage 0
      ;;
    --print-prompt)
      if [ $# -ne 5 ]; then
        usage 1
      fi
      local runs_dir=${2%/}
      local runs_json
      runs_json=$("$SCRIPT_DIR/summary" --runs "$runs_dir")
      local with_skill_run
      with_skill_run=$(nth_scored_run "$runs_json" "$3" with-skill "$4")
      local without_skill_run
      without_skill_run=$(nth_scored_run "$runs_json" "$3" without-skill "$4")
      if [ -z "$with_skill_run" ] || [ -z "$without_skill_run" ]; then
        echo "pairwise: task $3 has no pair $4" >&2
        exit 1
      fi
      build_prompt "$with_skill_run" "$without_skill_run" "$5"
      ;;
    --judge-one)
      # Internal: one judge call, started by xargs below.
      judge_one "$judge" "$2" "$3" "$4" "$5"
      ;;
    *)
      if [ $# -ne 1 ] || [ ! -d "$1" ]; then
        usage 1
      fi
      local runs_dir=${1%/}
      mkdir -p "$(results_dir "$runs_dir" "$judge")"
      local missing
      missing=$(list_missing_judgements "$runs_dir" "$judge")
      if [ -z "$missing" ]; then
        echo "pairwise: every pair is already judged"
        return 0
      fi
      # Fable is a Claude judge like opus, so it runs as many calls at once.
      local parallel_calls=$OPUS_PARALLEL_CALLS
      if [ "$judge" = gemini ]; then
        parallel_calls=$GEMINI_PARALLEL_CALLS
      fi
      # xargs -P runs up to parallel_calls calls at once; -L 1 gives each call one "task k order" line.
      # xargs exits non-zero if any call failed. Run the script again to retry only the failed ones.
      echo "$missing" | xargs -P "$parallel_calls" -L 1 "$SCRIPT_DIR/pairwise" --judge "$judge" --judge-one "$runs_dir"
      ;;
  esac
}

main "$@"
